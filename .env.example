# ==============================================================================
# Configuration d'environnement — SmartEnergy Hub (.env.example)
# Copier ce fichier vers .env pour surcharger les valeurs locales
# ==============================================================================

# --- Ports des Services Spring Boot (Hôte) ---
COLLECTOR_SERVER_PORT=8081
STORAGE_SERVER_PORT=8083

# --- Redis Streams (Docker) ---
# Note: 6380 est utilisé sur l'hôte si 6379 est déjà occupé par un autre conteneur
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_STREAM_NAME=energy-measurements
REDIS_STREAM_GROUP=storage-group

# --- Apache Cassandra (Docker Compose) ---
CASSANDRA_HOST=localhost
CASSANDRA_PORT=9042
# Le script CQL initialise le keyspace smartenergy ; adapter aussi le script si renommé.
CASSANDRA_KEYSPACE=smartenergy
CASSANDRA_LOCAL_DATACENTER=datacenter1
# Nom du cluster utilisé par le service Compose Cassandra
CASSANDRA_CLUSTER_NAME=SmartEnergy Hub

# --- MongoDB (Docker) ---
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=smartenergy
# URI utilisée par Spring Data MongoDB (pas d'authentification en développement local)
MONGO_URI=mongodb://localhost:27017/smartenergy

# --- Streamlit (Hôte) ---
STREAMLIT_SERVER_PORT=8501
